{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo/kitsune.icon",
    "height": 18
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "command",
      "key": " PC",
      "keyColor": "red",
      "text": "echo 稲荷の大神"
    },
    {
      "type": "custom",
      "format": "═════════════════════════════════════════════"
    },
    {
      "type": "cpu",
      "format": "{1} @ {7}",
      "key": "   CPU",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  󰊴 GPU",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "   Memory",
      "keyColor": "yellow"
    },
    {
      "type": "chassis",
      "key": "  󰇺 Chassis",
      "format": "{1} {2} {3}",
      "keyColor": "yellow"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "═════════════════════════════════════════════"
    },
    "break",
    {
      "type": "command",
      "key": "  ",
      "keyColor": "red",
      "text": "echo スターゾルのパソコン"
    },
    {
      "type": "custom",
      "format": "═════════════════════════════════════════════"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": "  󱗃 WM",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{2}",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "  󱦟 OS Age",
      "keyColor": "blue",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "═════════════════════════════════════════════"
    },
    { 
      "type": "colors", 
      "paddingLeft": 2, 
      "symbol": "circle" 
    },
    "break"
  ]
}
